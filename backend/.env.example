# LLM 供应商切换：kimi / deepseek / qwen
LLM_PROVIDER=qwen

# 千问（Qwen / DashScope 兼容模式）
# 获取 API Key: https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Kimi（Moonshot）
# 获取 API Key: https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# DeepSeek
# 获取 API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云 OSS（执行记录/打卡附件存储）
# 控制台: https://oss.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=your-bucket-name
ALIYUN_OSS_REGION=cn-hangzhou
# RAM 角色 ARN，预留给 STS 临时凭证（前端直传），可留空
ALIYUN_OSS_ROLE_ARN=
